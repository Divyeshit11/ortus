# Your store domain (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Paste ONE of these from: Sales channels → Headless → Storefront API
#
# EASIEST — Public access token (fully visible on screen, copy it):
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_token_here
#
# OR Private access token (click eye icon to reveal, starts with shpat_):
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_your_private_token_here
