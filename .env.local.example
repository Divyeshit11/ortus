# Copy this file to .env.local and fill in your values

# Your store domain (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=ortus-8910.myshopify.com

# Headless channel → Storefront API → Private access token (starts with shpat_)
# Sales channels → Headless → your storefront → Storefront API → Manage
# Click the eye icon to reveal, then copy. Do NOT use the Public access token here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_your_private_token_here

# NextAuth secret for session encryption (generate a random string)
# You can generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
